        {
            "parameters": {
                "jsCode": "// 1. Get all messages and IDs from the input\nconst allItems = $input.all();\n\n// Add safety check/filter\nconst messages = allItems.map(item => item.json.message_content).filter(Boolean);\nconst ids = allItems.map(item => item.json.id);\n\n// 2. Flatten them into a single string\nconst flattenedMessage = messages.join(', '); \nconst idString = ids.join(', ');\n\n// 3. Extract the sender safely\nconst sender = allItems.length > 0 ? allItems[0].json.message_sender : null;\n\n// 4. Return the new object\nreturn {\n  flattenedMessage,\n  idString,\n  sender,\n  count: allItems.length\n};"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
