            ],
            "id": "ac9367b6-6928-4cf0-b096-dd1ce09fbe0e",
            "name": "AI Agent"
        },
        {
            "parameters": {
                "jsCode": "const output = $json.output;\nlet messages = [];\ntry {\n  // Clean up potential markdown code blocks if the AI adds them\n  const cleanOutput = output.replace(/```json/g, '').replace(/```/g, '').trim();\n  const parsed = JSON.parse(cleanOutput);\n  \n  if (parsed.messages && Array.isArray(parsed.messages)) {\n    messages = parsed.messages;\n  } else {\n    messages = [cleanOutput];\n  }\n} catch (e) {\n  // Fallback if not JSON\n  messages = [output];\n}\n\n// We return the array directly as the output 'json' property for the Webhook to serialize\nreturn {\n  json: {\n    output: messages\n  }\n};"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
